        {
          "info": {
            "name": "Retrieves all profiles from a custom source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dowjones.com/risk-profiles-custom-sources/:id/profiles",
            "headers": [
              {
                "name": "Accept-Encoding",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page[offset]",
                "value": "",
                "type": "query",
                "description": "page offset"
              },
              {
                "name": "page[limit]",
                "value": "",
                "type": "query",
                "description": "page limit, should not be higher than 500"
              },
              {
                "name": "parts",
                "value": "id_only",
                "type": "query",
                "description": "Specifies if the profiles should be returned with all attributes or only the ids.\n  * all_attributes - Return all attributes for the profiles\n  * id_only - Returns only the profile ids (Default value)\n"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of the custom source."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves all profiles from a custom source"
